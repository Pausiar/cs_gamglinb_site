{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "cleanUrls": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/js/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/index?__p=auth/:path*" },
    { "source": "/api/:path*", "destination": "/api/index?__p=api/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
