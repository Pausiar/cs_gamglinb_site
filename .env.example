# Copia este archivo a .env y rellena los valores (en Vercel: Project Settings -> Environment Variables).

# Puerto HTTP local (solo npm start)
PORT=3000

# URL pública del sitio (sin barra final). Steam redirige aquí tras el login.
# En producción: https://tu-dominio.com  (las cookies serán Secure si es https)
# En Vercel, si no se define, se deduce de x-forwarded-proto/x-forwarded-host
# (mejor definirla siempre en producción).
BASE_URL=http://localhost:3000

# Secreto para firmar la cookie de sesión (obligatorio con NODE_ENV=production y en Vercel).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional: clave de la Steam Web API para mostrar nombre y avatar.
# Consíguela en https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# PS_Database (perfiles de los usuarios de Steam). Sin estas dos variables se usa
# un almacén en memoria (solo desarrollo; en Vercel hace falta ALLOW_MEMORY_STORE=1).
PSDB_URL=https://psdatabase.vercel.app
PSDB_API_KEY=
# PSDB_PROJECT=skindrop
# PSDB_TABLE=profiles
# PSDB_TIMEOUT_MS=8000

# NODE_ENV=production
# ALLOW_MEMORY_STORE=1
